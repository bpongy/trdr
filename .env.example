# Copier ce fichier en .env et le compléter. Ne jamais versionner le .env.

# --- Base de données (Docker) ---
# Lettres et chiffres uniquement : la valeur est insérée telle quelle dans l'URL de connexion.
POSTGRES_PASSWORD=

# --- Binance : compte virtuel uniquement ---
# testnet : https://testnet.binance.vision — demo : mode « Demo Trading » de Binance
BINANCE_ENV=testnet
BINANCE_API_KEY=
BINANCE_API_SECRET=
# sandbox : bougies de l'environnement virtuel — live : bougies du marché réel (lecture seule, sans clé)
MARKET_DATA_SOURCE=sandbox

# --- Marché et stratégie ---
SYMBOL=ETH/USDT
TIMEFRAME=4h
SMA_FAST=50
SMA_SLOW=200
RSI_PERIOD=14
RSI_ENTRY=40

# --- Risque ---
TRADE_SIZE_USDT=20
MAX_OPEN_POSITIONS=1
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.10
MAX_HOLD_DAYS=7
# Durée pendant laquelle un signal peut encore être validé à la main
SIGNAL_TTL_HOURS=8

# --- Notifications Telegram (optionnel : sans jeton, les messages vont dans les logs) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Authentification de l'interface : générer avec `python -m trdr.cli init-auth` ---
AUTH_PASSWORD_HASH=
AUTH_TOTP_SECRET=
JWT_SECRET=
JWT_TTL_MINUTES=720

# Origine du front s'il est servi sur un autre domaine que l'API (séparées par des virgules)
CORS_ORIGINS=
